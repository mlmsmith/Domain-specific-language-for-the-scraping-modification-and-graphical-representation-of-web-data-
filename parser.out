    (34) aggregation -> GROUP_BY COLUMN HAVING aggregate operator INTEGER .

    ORDER_BY        reduce using rule 34 (aggregation -> GROUP_BY COLUMN HAVING aggregate operator INTEGER .)
    PLOT            reduce using rule 34 (aggregation -> GROUP_BY COLUMN HAVING aggregate operator INTEGER .)
    $end            reduce using rule 34 (aggregation -> GROUP_BY COLUMN HAVING aggregate operator INTEGER .)


state 83

    (35) aggregation -> GROUP_BY COLUMN HAVING aggregate operator FLOAT .

    ORDER_BY        reduce using rule 35 (aggregation -> GROUP_BY COLUMN HAVING aggregate operator FLOAT .)
    PLOT            reduce using rule 35 (aggregation -> GROUP_BY COLUMN HAVING aggregate operator FLOAT .)
    $end            reduce using rule 35 (aggregation -> GROUP_BY COLUMN HAVING aggregate operator FLOAT .)


state 84

    (45) vars -> VARS EQUALS MODIFIER .

    $end            reduce using rule 45 (vars -> VARS EQUALS MODIFIER .)

